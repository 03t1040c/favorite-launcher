{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "search-launcher-app",
  "version": "0.3.5",
  "identifier": "com.t10.search-launcher-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../work/dist"
  },
  "app": {
    "windows": [
      {
        "title": "search-launcher-app",
        "width": 1100,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 760,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
