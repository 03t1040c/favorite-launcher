{
  "manifest_version": 3,
  "name": "Search Launcher Edge History Sync",
  "version": "1.1.0",
  "description": "Edgeの履歴をSearch Launcherへバックグラウンド同期します。",
  "key": "",
  "permissions": ["history", "nativeMessaging", "storage", "alarms", "activeTab"],
  "action": { "default_title": "Favorite Launcherへ保存", "default_popup": "popup.html" },
  "background": { "service_worker": "service_worker.js" }
}
